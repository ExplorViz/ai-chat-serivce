{
  "name": "explorviz-ai-chat-service",
  "version": "2.0.0",
  "description": "ExplorViz AI chat service. Bridges the ExplorViz frontend chatbot to LLM providers (OpenAI, Anthropic, Google) via the CopilotKit runtime.",
  "license": "MIT",
  "author": "Karim Issa",
  "contributors": ["Malte Hansen"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx}'",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "prepublishOnly": "pnpm run lint",
    "preversion": "pnpm run lint",
    "version": "pnpm run format",
    "postversion": "git push --follow-tags"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "prettier-preset": "^1.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "typescript-preset": "^1.0.1"
  },
  "prettier": "prettier-preset",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.94.0",
    "@copilotkit/runtime": "^1.57.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^6.36.0"
  },
  "packageManager": "pnpm@10.33.3"
}
