{
  "name": "explorviz-ai-chat-service",
  "version": "2.0.0",
  "description": "ExplorViz AI chat service. Bridges the ExplorViz frontend chatbot to LLM providers (OpenAI, Anthropic, Google) via the CopilotKit runtime.",
  "license": "MIT",
  "author": "Karim Issa",
  "contributors": ["Malte Hansen"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx}'",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "prepublishOnly": "pnpm run lint",
    "preversion": "pnpm run lint",
    "version": "pnpm run format",
    "postversion": "git push --follow-tags"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.2",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "prettier-preset": "^1.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "typescript-preset": "^1.0.1"
  },
  "prettier": "prettier-preset",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.57.0",
    "@copilotkit/runtime": "^1.57.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "openai": "^5.12.2"
  },
  "packageManager": "pnpm@10.27.0"
}
